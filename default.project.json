{
  "name": "PhysicsSimCollisions",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$path": "src/replicated",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared",
        "$ignoreUnknownInstances": true
      },
      "Packages": {
        "$className": "Folder",
        "$path": { "optional": "Packages" }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "ServerPackages": {
        "$className": "Folder",
        "$path": { "optional": "ServerPackages" }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
